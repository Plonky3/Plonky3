                                                   (403727924 : u32)])])))
     (by rfl)
 
-def _ : rust_primitives.hax.Tuple0 :=
+def const_check_1 : rust_primitives.hax.Tuple0 := -- PATCHED: hax emitted `def _`
   RustM.of_isOk
     (do
     (hax_lib.assert
