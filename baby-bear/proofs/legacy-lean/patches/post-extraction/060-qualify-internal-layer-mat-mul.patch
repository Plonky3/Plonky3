-    (Impl_2.internal_layer_mat_mul_hoisted R)
+    (p3_baby_bear.poseidon2.Impl_2.internal_layer_mat_mul_hoisted R) -- PATCHED
+    -- (Impl_2.internal_layer_mat_mul_hoisted R)
 
