diff --git a/field/src/field.rs b/field/src/field.rs
index 9444da7d..56433cf3 100644
--- a/field/src/field.rs
+++ b/field/src/field.rs
@@ -1035,13 +1035,30 @@ pub trait RawDataSerializable: Sized {
     }
 }
 
+/// PATCHED: the `RawDataSerializable` edge of [`Field`], behind `hax_backend_lean`.
+///
+/// In a normal build this is exactly `RawDataSerializable` (blanket-implemented,
+/// and supertraits are transitive), so `F: Field` still implies
+/// `F: RawDataSerializable`. Under hax's Lean backend it is empty, which cuts
+/// `RawDataSerializable`'s `-> impl IntoIterator` methods (hidden GATs, which
+/// aeneas cannot translate) out of everything that mentions `Field`.
+#[cfg(not(hax_backend_lean))]
+pub trait FieldRawData: RawDataSerializable {}
+#[cfg(not(hax_backend_lean))]
+impl<T: RawDataSerializable> FieldRawData for T {}
+/// See the normal-build definition.
+#[cfg(hax_backend_lean)]
+pub trait FieldRawData {}
+#[cfg(hax_backend_lean)]
+impl<T> FieldRawData for T {}
+
 /// A field `F`. This permits both modular fields `ℤ/p` along with their field extensions.
 ///
 /// A ring is a field if every element `x` has a unique multiplicative inverse `x^{-1}`
 /// which satisfies `x * x^{-1} = F::ONE`.
 pub trait Field:
     Algebra<Self>
-    + RawDataSerializable
+    + FieldRawData // PATCHED: was `RawDataSerializable`
     + Packable
     + 'static
     + Copy
