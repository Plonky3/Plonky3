   mds.MDSBabyBearData := {
   clone := mds.MDSBabyBearData.Insts.CoreCloneClone.clone
+  -- PATCHED: default method, body of `core.clone.Clone.clone_from.default`
+  clone_from := fun _ source => (mds.MDSBabyBearData.Insts.CoreCloneClone.clone) source
 }
 
